# ─────────────────────────────────────────────────────────────
#  PrintDrop  —  Environment Variables
#  Copy this file to .env and fill in all values before running
# ─────────────────────────────────────────────────────────────

# Your deployed URL — set this to your Render URL once deployed
# e.g.  https://printdrop.onrender.com
# For local dev leave it as http://localhost:5000
APP_URL=https://your-app-name.onrender.com

# Google OAuth credentials
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# The Google account email that will have owner/dashboard access
OWNER_EMAIL=yourshop@gmail.com

# Random strong string for signing session cookies
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Key used to encrypt uploaded files at rest
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_a_different_long_random_string

# Server port (Render sets this automatically, leave as 5000 locally)
PORT=5000
